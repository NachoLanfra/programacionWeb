package views

import (
	"strconv"

	"ejerEsp.com/ejerEsp/db/sqlc"
)

// Estados posibles de una cursada: valor que se guarda y texto que se muestra.
var estados = []struct{ Valor, Texto string }{
	{"sin_cursar", "Sin cursar"},
	{"cursando", "Cursando"},
	{"regular", "Regular"},
	{"finalizada", "Finalizada"},
}

// notaTexto devuelve la nota como texto, o "" si todavía no tiene.
func notaTexto(fila sqlc.ListPlanUsuarioRow) string {
	if !fila.Nota.Valid {
		return ""
	}
	return strconv.FormatFloat(float64(fila.Nota.Float32), 'f', -1, 32)
}

templ CursadaForm(fila sqlc.ListPlanUsuarioRow) {
	<form method="POST" action="/cursadas">
		<input type="hidden" name="materia_id" value={ strconv.Itoa(int(fila.IDMateria)) }/>
		<fieldset role="group">
			<select name="estado" aria-label="Estado">
				for _, e := range estados {
					<option value={ e.Valor } selected?={ e.Valor == fila.Estado }>{ e.Texto }</option>
				}
			</select>
			<input type="number" name="nota" min="4" max="10" step="0.01" placeholder="Nota" aria-label="Nota" value={ notaTexto(fila) }/>
			<button type="submit">Guardar</button>
		</fieldset>
	</form>
}
