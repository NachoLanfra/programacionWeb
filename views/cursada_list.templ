package views

import (
	"strconv"

	"ejerEsp.com/ejerEsp/db/sqlc"
)

// Tabla del plan; es el hx-target de los formularios.
templ CursadaList(plan []sqlc.ListPlanUsuarioRow) {
	<section id="plan">
		<h2>Mi plan de estudios</h2>
		if len(plan) == 0 {
			<p>No hay materias cargadas en el plan.</p>
		} else {
			<table>
				<thead>
					<tr>
						<th>Año</th>
						<th>Cuat.</th>
						<th>Materia</th>
						<th>Estado y nota</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					for _, fila := range plan {
						@CursadaFila(fila)
					}
				</tbody>
			</table>
		}
	</section>
}

// Fila de una materia; el botón Borrar aparece si tiene algo cargado.
templ CursadaFila(fila sqlc.ListPlanUsuarioRow) {
	<tr>
		<td>{ strconv.Itoa(int(fila.Anio)) }°</td>
		<td>{ strconv.Itoa(int(fila.Cuatrimestre)) }°</td>
		<td>{ fila.Nombre }</td>
		<td>
			@CursadaForm(fila)
		</td>
		<td>
			if fila.Estado != "sin_cursar" {
				<button
					type="button"
					class="secondary outline"
					hx-delete={ "/cursadas/" + strconv.Itoa(int(fila.IDMateria)) }
					hx-target="closest tr"
					hx-swap="outerHTML"
					hx-confirm={ "¿Borrar la cursada de " + fila.Nombre + "?" }
				>Borrar</button>
			}
		</td>
	</tr>
}

// Fila reseteada más el aviso, como respuesta al borrar.
templ FilaConAviso(fila sqlc.ListPlanUsuarioRow, aviso Aviso) {
	@CursadaFila(fila)
	<hx-partial hx-target="#aviso" hx-swap="innerHTML">
		@AvisoContenido(aviso)
	</hx-partial>
}
